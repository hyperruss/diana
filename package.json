    "configure:tbank": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy/configure-tbank.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy/deploy.ps1"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.7"
  }
}
